// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EstadoResena {
  VISIBLE
  OCULTA
  PENDIENTE
}

enum EstadoAlumno {
  ACTIVO
  INACTIVO
  BAJA
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoPago {
  COMPLETO
  PARCIAL
}

enum ResultadoCombate {
  VICTORIA
  DERROTA
  EMPATE
  NO_CONTEST
}

model Alumno {
  id                  Int           @id @default(autoincrement())
  nombre              String        @db.VarChar(100)
  apellido            String        @db.VarChar(100)
  fechaNacimiento     DateTime      @map("fecha_nacimiento") @db.Date
  telefono            String?       @db.VarChar(20)
  fotoUrl             String?       @map("foto_url") @db.VarChar(500)

  // Datos deportivos
  estado              EstadoAlumno  @default(ACTIVO)
  fechaInscripcion    DateTime      @map("fecha_inscripcion") @default(now()) @db.Date
  grado               String?

  // Datos de pago
  mensualidad         Decimal       @db.Decimal(8, 2)
  diaLimitePago       Int           @map("dia_limite_pago") @default(5)
  
  // Timestamps
  creadoEn            DateTime      @map("creado_en") @default(now())

  // Datos médicos
  grupoSanguineo       String?
  alergias             String?
  lesionesAnteriores   String?
  padecimientosHereditarios String?
  usaLentes            Boolean @default(false)
  usaOrtodoncia        Boolean @default(false)
  usaZapatosOrtopedicos Boolean @default(false)

  // Seguro médico
  nombreSeguro  String?
  numeroSeguro  String?

  // Médico particular
  nombreMedico    String?
  domicilioMedico String?
  telefonoMedico  String?

  // Info adicional
  notasAdicionales String?
  otrosDeportes    String?
  numerOHermanos    Int?

  // Autorización de fotografías
  autorizaFotos Boolean @default(false)
  
  // Relaciones
  tutores             Tutor[]
  personasAutorizadas PersonaAutorizada[]
  expectativas        ExpectativaAlumno[]
  pagos               Pago[]
  asistencias         Asistencia[]
  combates            Combate[]
  eventos AlumnoEvento[]
  apartados  Apartado[]
  
  @@map("alumnos")
}

model Tutor {
  id        Int      @id @default(autoincrement())
  alumnoId  Int
  alumno    Alumno   @relation(fields: [alumnoId], references: [id])

  rol        RolTutor
  nombre     String
  apellidos  String
  edad       Int?
  ocupacion  String?
  telefono   String
}

enum RolTutor {
  MADRE
  PADRE
  TUTOR
}

model PersonaAutorizada {
  id       Int    @id @default(autoincrement())
  alumnoId Int
  alumno   Alumno @relation(fields: [alumnoId], references: [id])

  nombreCompleto String
  telefono       String?
}

enum TipoExpectativa {
  SOCIALIZAR
  TRABAJO_EN_EQUIPO
  COMPETENCIA_FORMAL
  DESARROLLO_FISICO
  CONTROL_DE_PESO
  AUTOCONTROL
  DISCIPLINA_Y_RESPETO
  MEJORAR_CONDUCTA
  ALEJARLO_DE_DISPOSITIVOS
  APRENDER_A_DEFENDERSE
}

model ExpectativaAlumno {
  id       Int             @id @default(autoincrement())
  alumnoId Int
  alumno   Alumno          @relation(fields: [alumnoId], references: [id])
  tipo     TipoExpectativa

  @@unique([alumnoId, tipo])
}

model Pago {
  id                  Int           @id @default(autoincrement())
  alumnoId            Int           @map("alumno_id")
  fechaPago           DateTime      @map("fecha_pago") @default(now()) @db.Date
  monto               Int       
  metodoPago          MetodoPago    @map("metodo_pago") @default(EFECTIVO)
  mesCorrespondiente  String        @map("mes_correspondiente") @db.VarChar(7)  // formato: "2025-01"
  estadoPago          EstadoPago    @map("estado_pago") @default(PARCIAL)
  notas               String?       @db.Text
  registradoPor       String?       @map("registrado_por") @db.VarChar(100)
  mensualidadCompleta Boolean  @default(false)

  // Timestamps
  creadoEn            DateTime      @map("creado_en") @default(now())

  // Relaciones
  alumno              Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([mesCorrespondiente])
  @@index([estadoPago])
  @@map("pagos")
}

// ============================================================
// TABLA: Asistencia
// ============================================================

model Asistencia {
  id                  Int           @id @default(autoincrement())
  alumnoId            Int           @map("alumno_id")
  fecha               DateTime      @default(now()) @db.Date
  horaEntrada         DateTime      @map("hora_entrada") @db.Time
  horaSalida          DateTime?     @map("hora_salida") @db.Time
  observacion         String?       @db.Text

  // Timestamps
  creadoEn            DateTime      @map("creado_en") @default(now())

  // Relaciones
  alumno              Alumno        @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@unique([alumnoId, fecha])
  @@index([alumnoId])
  @@index([fecha])
  @@map("asistencias")
}

// ============================================================
// TABLA: Combate
// ============================================================

model Combate {
  id                  Int               @id @default(autoincrement())
  alumnoId            Int               @map("alumno_id")
  fecha               DateTime          @db.Date
  rival               String?            @db.VarChar(150)
  resultado           ResultadoCombate
  categoria           String?           @db.VarChar(50)
  evento              String?           @db.VarChar(200)
  lugar               String?           @db.VarChar(200)
  notas               String?           @db.Text

  // Timestamps
  creadoEn            DateTime          @map("creado_en") @default(now())

  // Relaciones
  alumno              Alumno            @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([fecha])
  @@map("combates")
}

// ============================================================
// TABLA: Resena
// ============================================================

model Resena {
  id                  Int           @id @default(autoincrement())
  fecha               DateTime      @default(now())
  calificacion        Int           // 1 a 5 estrellas
  comentario          String        @db.Text
  estado              EstadoResena  @default(PENDIENTE)

  // Timestamps
  creadoEn            DateTime      @map("creado_en") @default(now())

  @@index([estado])
  @@map("resenas")
}

model User {
  id        Int      @id @default(autoincrement())
  usuario   String?  @unique
  password  String
  nombre    String?
  apellido  String?
  role      Role     @default(USER)
  estatus   Boolean  @default(true)
  createdAt DateTime @default(now())
  ventas      Venta[]
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
}

model Novedades {
  id          Int      @id @default(autoincrement())
  titulo      String    
  descripcion  String   
  vigencia     String?
  estatus        Boolean  @default(true)
  imagen     String?
  publicId   String?
}

model categoriaProducto {
  id          Int      @id @default(autoincrement())
  nombre      String    
  estatus        Boolean  @default(true)
}

model productos {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion  String
  imagen     String?
  publicId   String?
  costo     Decimal @db.Decimal(8, 2)
  categoria  String
  estatus        Boolean  @default(true)
  descripcionVenta String?
  cantidad Int  @default(0)
  detalles    DetalleVenta[]
  apartados  DetalleApartado[]
}

model Venta {
  id          Int            @id @default(autoincrement())
  fecha       DateTime       @default(now())
  total       Decimal        @db.Decimal(8, 2)
  estatus     Boolean        @default(true)
  metodoPago          MetodoPago    @map("metodo_pago") @default(EFECTIVO)
  usuarioId   Int
  usuario     User           @relation(fields: [usuarioId], references: [id])
  detalles    DetalleVenta[]
  apartado   Apartado?
}

model DetalleVenta {
  id          Int       @id @default(autoincrement())
  cantidad    Int
  precioVenta Decimal   @db.Decimal(8, 2)
  subtotal    Decimal   @db.Decimal(8, 2)
  ventaId     Int
  venta       Venta     @relation(fields: [ventaId], references: [id])
  productoId  Int
  producto    productos @relation(fields: [productoId], references: [id])
}

model imagenCarrusel {
  id          Int      @id @default(autoincrement())
  nombre      String?
  url     String
  publicId   String?
  estatus        Boolean  @default(true)
}

model videos {
  id          Int      @id @default(autoincrement())
  nombre      String? 
  descripcion  String?   
  url     String
  publicId    String
  estatus        Boolean  @default(true)
  orden       Int      @default(0)
  creadoEn    DateTime @default(now())
}

model costoExtraMensualidad {
  id          Int      @id @default(autoincrement())
  dias String
  costo Int
  descripcion String 
}

model pagoMesAlumno{
  id          Int      @id @default(autoincrement())
  alumnoId            Int               @map("alumno_id")
  mes String  // formato: "2026-01"
}


enum TipoEvento {
  TORNEO
  EXAMEN
  SEMINARIO
  EXHIBICION  
  GRADUACION
  CAMPAMENTO
  OTRO
}

model Evento {
  id          Int          @id @default(autoincrement())
  nombre      String
  tipoEvento  TipoEvento
  costo       Int
  fecha       DateTime
  hora        String?
  estado      String?
  ciudad      String?
  ubicacion   String?
  descripcion String?

  // Relación con alumnos
  alumnos     AlumnoEvento[]
}

model AlumnoEvento {
  id        Int      @id @default(autoincrement())
  alumnoId  Int
  eventoId  Int
  alumno    Alumno   @relation(fields: [alumnoId], references: [id])
  evento    Evento   @relation(fields: [eventoId], references: [id])
  pagado    Boolean   @default(false)

  // Datos de participación
  categoria    String?
  resultado    String?
  confirmado   Boolean   @default(true)
  notas        String?
  inscritoEn   DateTime  @default(now())
  grado        String?

  pagosEvento  PagoEvento[]

  @@unique([alumnoId, eventoId])
}

model PagoEvento {
  id             Int          @id @default(autoincrement())
  alumnoEventoId Int          @map("alumno_evento_id")
  monto          Int
  metodoPago     MetodoPago   @map("metodo_pago") @default(EFECTIVO)
  fechaPago      DateTime     @map("fecha_pago") @db.Date
  notas          String?      @db.Text
  registradoPor  String?      @map("registrado_por") @db.VarChar(100)
  creadoEn       DateTime     @map("creado_en") @default(now())

  alumnoEvento   AlumnoEvento @relation(fields: [alumnoEventoId], references: [id], onDelete: Cascade)

  @@index([alumnoEventoId])
  @@map("pagos_evento")
}

enum EstadoApartado {
  PENDIENTE   // tiene saldo, se puede abonar
  COMPLETADO  // se liquidó y se generó la venta
  CANCELADO
}

model Apartado {
  id           Int             @id @default(autoincrement())
  alumnoId     Int             @map("alumno_id")
  alumno       Alumno          @relation(fields: [alumnoId], references: [id])

  total        Decimal         @db.Decimal(10, 2) // congelado al crear
  totalAbonado Decimal         @default(0) @db.Decimal(10, 2)
  estado       EstadoApartado  @default(PENDIENTE)

  fechaApartado DateTime       @default(now()) @map("fecha_apartado")
  fechaLimite   DateTime?      @map("fecha_limite") @db.Date
  fechaLiquidacion DateTime?   @map("fecha_liquidacion")
  notas         String?

  usuarioId    Int?            @map("usuario_id") // quién lo registró (si tienes tabla Usuario)

  detalles     DetalleApartado[]
  abonos       AbonoApartado[]

  ventaId      Int?            @unique @map("venta_id") // se llena al liquidar
  venta        Venta?          @relation(fields: [ventaId], references: [id])

  @@index([alumnoId])
  @@index([estado])
  @@map("apartados")
}

model DetalleApartado {
  id             Int       @id @default(autoincrement())
  apartadoId     Int       @map("apartado_id")
  apartado       Apartado  @relation(fields: [apartadoId], references: [id], onDelete: Cascade)

  productoId     Int       @map("producto_id")
  producto       productos @relation(fields: [productoId], references: [id])

  cantidad       Int
  precioUnitario Decimal   @db.Decimal(8, 2) // precio congelado al momento del apartado
  subtotal       Decimal   @db.Decimal(10, 2)

  @@index([apartadoId])
  @@map("detalle_apartado")
}

model AbonoApartado {
  id         Int        @id @default(autoincrement())
  apartadoId Int        @map("apartado_id")
  apartado   Apartado   @relation(fields: [apartadoId], references: [id], onDelete: Cascade)

  monto      Decimal    @db.Decimal(8, 2)
  metodoPago MetodoPago @default(EFECTIVO)
  fechaPago  DateTime   @default(now()) @map("fecha_pago")
  referencia String?    // folio, últimos 4 dígitos, etc.
  notas      String?
  usuarioId  Int?       @map("usuario_id")

  @@index([apartadoId])
  @@map("abonos_apartado")
}

model grados {
  id          Int      @id @default(autoincrement())
  nombre      String 
  descripcion  String?   
  estatus        Boolean  @default(true)
  orden       Int      @default(0)
  creadoEn    DateTime @default(now())
}